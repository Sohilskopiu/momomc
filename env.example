# The same bot token the website uses to create tickets
DISCORD_BOT_TOKEN=
# Your website, no trailing slash
SITE_URL=https://your-site.vercel.app
# Must match BOT_API_KEY on Vercel (any long random string, 16+ characters)
BOT_API_KEY=

# Staff role and log channel for each mode are set in the website Admin Panel > Game Modes.
# These are only a fallback if the website cannot be reached (optional).
STAFF_ROLE_SURVIVAL=
STAFF_ROLE_LIFESTEAL=
LOG_CHANNEL_SURVIVAL=
LOG_CHANNEL_LIFESTEAL=
# Owner Discord ID, pinged 5 times when a buyer sends a payment screenshot (optional, default is built in)
OWNER_ID=1373581087506301003
